<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">


	<!-- =========================================================
         CONFIGURAÇÃO DO PROJETO
         ========================================================= -->

	<modelVersion>4.0.0</modelVersion>


	<!-- =========================================================
         SPRING BOOT PARENT

         Fornece:
         - Gerenciamento de dependências
         - Configuração de plugins
         - Versões padrão das bibliotecas
         ========================================================= -->

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.0</version>
		<relativePath/>
	</parent>


	<!-- =========================================================
         IDENTIFICAÇÃO DO PROJETO
         ========================================================= -->

	<groupId>com.dinisjovete</groupId>

	<artifactId>rest-with-springboot-java</artifactId>

	<version>0.0.1-SNAPSHOT</version>

	<name>rest-with-springboot-java</name>

	<description>
		Projeto de API REST desenvolvido com Spring Boot
	</description>


	<!-- =========================================================
         VERSÃO DO JAVA

         Java 21 = Versão LTS (Suporte de Longo Prazo)
         ========================================================= -->

	<properties>
		<java.version>21</java.version>
	</properties>


	<!-- =========================================================
         DEPENDÊNCIAS DO PROJETO
         ========================================================= -->

	<dependencies>


		<!--
             SPRING WEB

             Fornece:
             - Spring MVC
             - Controllers para API REST
             - Conversão de JSON com Jackson

             Utilizado para criar aplicações web e APIs REST.
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>


		<!--
             MYSQL CONNECTOR / J

             Fornece o driver de conexão JDBC para comunicação
             com o banco de dados MySQL.

             O scope runtime significa que a dependência será
             usada durante a execução da aplicação.
        -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>


		<!--
             DEVTOOLS

             Reinicia a aplicação automaticamente durante o
             desenvolvimento sempre que houver alterações no código.
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>


		<!--
             SUPORTE A TESTES

             Fornece:
             - JUnit 5
             - Mockito
             - Spring Test
             - MockMvc

             Utilizado para criação de testes automatizados.
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>


	</dependencies>


	<!-- =========================================================
         CONFIGURAÇÃO DE BUILD E PLUGINS
         ========================================================= -->

	<build>

		<plugins>

			<!--
                 Plugin oficial do Spring Boot para compilar,
                 executar e empacotar a aplicação em um arquivo
                 JAR executável.
            -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>

	</build>


</project>