=============================================================================CRUD=================================================
1.
🏗️ Criação da Tabela (DDL)
CREATE TABLE IF NOT EXISTS public.person (
    id SERIAL PRIMARY KEY,
    first_name VARCHAR(80) NOT NULL,
    last_name VARCHAR(80) NOT NULL,
    address VARCHAR(100) NOT NULL,
    gender VARCHAR(6) NOT NULL,
    email VARCHAR(100),
    cpf VARCHAR(14),
    password VARCHAR(255),
    role VARCHAR(20)
);

=================================================================================
2. 📥 Inserção de Dados - CREATE (INSERT)

-- Inserindo um novo registro na tabela person
INSERT INTO public.person (first_name, last_name, address, gender, email, cpf, password, role)
VALUES ('Diniz', 'Jovete', 'Brasília - DF', 'Male', 'diniz@email.com', '000.000.000-00', '$2a$10$exemploHashSenha', 'ADMIN');

=================================================================================
3. 🔍 Consulta de Dados - READ (SELECT)
-- Buscar todos os registros
SELECT * FROM public.person;

-- Buscar por ID específico
SELECT * FROM public.person WHERE id = 1;

-- Buscar por e-mail ou nome
SELECT id, first_name, email, role FROM public.person WHERE first_name ILIKE '%Diniz%';

=================================================================================
4. ✏️ Atualização de Dados - UPDATE
-- Atualizar o endereço e o papel (role) de um registro específico
UPDATE public.person
SET first_name = 'FIlipe',
    email = 'filipe@yahoo.com',
    role = 'CLIENT'
WHERE id = 8;

=================================================================================
5. 🗑️ Exclusão de Dados - DELETE
-- Deletar um registro específico por ID
DELETE FROM public.person WHERE id = 1;