2. 🔍 Consultas e Manipulação de Dados (DML)

-- Consultar dados (person-> conresponde a tabela no banco de dados)
SELECT * FROM person;
SELECT * FROM person WHERE id = 1;

-- Insere um novo registro informando as colunas obrigatórias (first_name, last_name, address, gender)
INSERT INTO person (first_name, last_name, address, gender)
VALUES ('João', 'Silva', 'Brasília - DF', 'Male');

-- Atualizar dados de um objeto específico (id = 1) na tabela person para uma informação diferente (first_name = 'Carlos') ou mais
UPDATE person SET first_name = 'Carlos' WHERE id = 1; (apenas atualiza a coluna first_name)

UPDATE public.person (mais de uma coluna)
SET first_name = 'Carlos',
    last_name = 'Oliveira',
    address = 'Taguatinga - DF'
WHERE id = 1;



-- Deletar dados
DELETE FROM person WHERE id = 1;

3. 📋 Estrutura e Inspeção (DDL e Metadados)

-- Listar todas as tabelas do schema público
SELECT table_name FROM information_schema.tables WHERE table_schema = 'public';

-- Ver colunas e tipos de dados de uma tabela
SELECT column_name, data_type, is_nullable FROM information_schema.columns WHERE table_name = 'person';

